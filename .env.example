# Space InZader — copier en .env SUR LE SERVEUR (à côté de docker-compose.yml) et remplir.
# Le fichier .env n'est jamais commité.

# Jeton de la page privée des avis : https://space.linkatplug.be/api/avis/<jeton>/
# Au moins 24 caractères ; le générer avec :  openssl rand -hex 24
# Vide → page privée désactivée (les avis sont quand même enregistrés).
FEEDBACK_ADMIN_TOKEN=

# Port du jeu sur le serveur (8118 par défaut)
# HOST_PORT=8118
